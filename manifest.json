{
  "manifest_version": 2,
  "name": "Open in Gmail",
  "version": "0.0.1",
  "description": "Open the current email in Gmail web interface",
  "author": "Thunderbird Gmail Extension",
  "applications": {
    "gecko": {
      "id": "{b87af2eb-dd17-4124-8f7e-f338f0a71b28}",
      "strict_min_version": "78.0"
    }
  },
  "permissions": [
    "messagesRead",
    "accountsRead"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "message_display_action": {
    "default_title": "Open in Gmail",
    "default_icon": {
      "16": "icons/gmail-16.png",
      "32": "icons/gmail-32.png"
    }
  },
  "icons": {
    "48": "icons/gmail-48.png",
    "96": "icons/gmail-96.png"
  }
}
